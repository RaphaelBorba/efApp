{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["id", "tipo", "severidade", "criadoEm"],
    "properties": {
      "id": { "type": "string" },
      "tipo": { "type": "string", "enum": ["CONSUMO_CRITICO", "OCIOSIDADE", "META_EXCEDIDA"] },
      "severidade": { "type": "string", "enum": ["INFO", "WARN", "CRITICAL"] },
      "mensagem": { "type": ["string", "null"] },
      "equipamentoId": { "type": ["string", "null"] },
      "setorId": { "type": ["string", "null"] },
      "criadoEm": { "type": "string" }
    }
  }
}
