# Conexão com MongoDB
# Formato: mongodb://<host>:<porta>/<database>
MONGO_URI=mongodb://mongo:27017/efenergia

# Segredo para assinatura dos tokens JWT (use uma string longa e aleatória em produção)
APP_JWT_SECRET=troque_por_um_segredo_seguro_de_pelo_menos_32_caracteres

# Tempo de expiração do token JWT em segundos (padrão: 3600 = 1 hora)
APP_JWT_EXPIRATION_SECONDS=3600

# Perfil ativo do Spring: dev | staging | prod
SPRING_PROFILES_ACTIVE=dev

# Porta exposta pela API (usada no docker-compose)
APP_PORT=8080
